# Contoh env untuk build demo statis (tanpa backend sama sekali).
#
# Pakai lewat: npm run build:demo
# (script itu sudah menyetel variabel ini langsung di invocation `next build`,
# karena NEXT_PUBLIC_* di-inline oleh Next.js SAAT BUILD — cukup ada di file
# .env saja tidak akan berpengaruh kalau tidak ikut di-set saat build berjalan.)
#
# Tidak ada secret yang dibutuhkan untuk mode ini — semua data dilayani dari
# src/lib/mockData + src/lib/mockBackend.ts di browser.

NEXT_PUBLIC_DEMO_MODE=true
