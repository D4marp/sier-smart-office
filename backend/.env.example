# Backend Environment Variables
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_energy_dashboard
DB_PORT=3306
PORT=5001
NODE_ENV=development
JWT_SECRET=unesa_smart_energy_secret_key_2024

# Multi-tenant (satu database per fakultas, registry di rektorat)
# Registry default memakai kredensial DB_* di atas; override bila terpisah:
REGISTRY_DB_NAME=smart_energy_registry
# REGISTRY_DB_HOST=
# REGISTRY_DB_PORT=
# REGISTRY_DB_USER=
# REGISTRY_DB_PASSWORD=
# Tenant fallback bila request tidak membawa header X-Tenant (mis. Node-RED lama)
DEFAULT_TENANT=psikologi

# Node-RED / LoRa Gateway TCP Config
GATEWAY_HOST=10.12.1.150
TCP_TIMEOUT_MS=3000
TCP_RETRY_ATTEMPTS=1
TCP_RETRY_DELAY_MS=500
