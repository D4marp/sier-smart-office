# Backend Environment Variables
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_energy_sier
DB_PORT=3306
PORT=5001
NODE_ENV=development
JWT_SECRET=sier_smart_office_secret_key_2026

# Tenant tunggal (gedung kantor SIER). Registry default memakai kredensial
# DB_* di atas; override bila terpisah:
REGISTRY_DB_NAME=smart_energy_registry
# REGISTRY_DB_HOST=
# REGISTRY_DB_PORT=
# REGISTRY_DB_USER=
# REGISTRY_DB_PASSWORD=
# Tenant fallback global bila request tidak membawa header X-Tenant.
DEFAULT_TENANT=sier
# Tenant default per host/IP, format: host=tenant,host2=tenant2
DEFAULT_TENANT_HOSTS=

# Node-RED / LoRa Gateway TCP Config
GATEWAY_HOST=10.12.1.150
TCP_TIMEOUT_MS=3000
TCP_RETRY_ATTEMPTS=1
TCP_RETRY_DELAY_MS=500
