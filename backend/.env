# Backend Environment Variables
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_energy_dashboard
DB_PORT=3306
PORT=5001
NODE_ENV=development
JWT_SECRET=unesa_smart_energy_secret_key_2024
