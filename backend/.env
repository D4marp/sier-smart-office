# Multi-tenant (satu database per fakultas, registry di rektorat)
# Mini PC ini dipasang di FIKK -> default tenant fikk
REGISTRY_DB_NAME=smart_energy_registry
DEFAULT_TENANT=fikk
DEFAULT_TENANT_HOSTS=10.12.1.97=psikologi

# Node-RED / LoRa Gateway TCP Config
GATEWAY_HOST=10.12.1.150
MINI_PC_NODE_RED_HOST=127.0.0.1
TCP_TIMEOUT_MS=3000
TCP_RETRY_ATTEMPTS=1
TCP_RETRY_DELAY_MS=500

# FIKK: lampu/AC/proyektor lewat Node-RED Mini PC (http in /api/<classKey>),
# Node-RED yang convert ke TCP override ke UG65 -- lihat DeviceController.js
NODERED_BASE_URL=http://localhost:1880
