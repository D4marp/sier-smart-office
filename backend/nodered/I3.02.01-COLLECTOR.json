    {
        "id": "fp_01_acOnOff",
        "type": "function",
        "z": "fp_01_tab",
        "name": "ON/OFF AC_I3.02.01",
        "func": "let state = msg.payload.state;\n\nif (typeof state === \"string\") {\n    state = state.toLowerCase();\n}\n\nif (state === \"on\") {\n    msg.payload = Date.now();\n    msg.source = \"web_ac\";\n    msg.ac_state = \"on\";\n    return [msg, null];\n}\n\nif (state === \"off\") {\n    msg.payload = Date.now();\n    msg.source = \"web_ac\";\n    msg.ac_state = \"off\";\n    return [null, msg];\n}\n\nnode.warn(\"Command AC tidak valid: \" + JSON.stringify(msg.payload));\nreturn null;",
