    {
        "id": "fp_01_projOnOff",
        "type": "function",
        "z": "fp_01_tab",
        "name": "ON/OFF proyektor_I3.02.01",
        "func": "let state = msg.payload.state;\n\nif (typeof state === \"string\") {\n    state = state.toLowerCase();\n}\n\nif (state === \"on\") {\n    msg.source = \"web_projector\";\n    msg.projector_state = \"on\";\n    return [msg, null];\n}\n\nif (state === \"off\") {\n    msg.source = \"web_projector\";\n    msg.projector_state = \"off\";\n    return [null, msg];\n}\n\nnode.warn(\"Command proyektor tidak valid: \" + JSON.stringify(msg.payload));\nreturn null;",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
