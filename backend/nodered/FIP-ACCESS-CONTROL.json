    {
        "id": "access_httpRetryFn",
        "type": "function",
        "z": "14712064f2909bd2",
        "name": "retry_or_drop_access",
        "func": "// Ditambahkan: Web API sesekali sempat tidak terjangkau sesaat (bukan\n// backend mati). Coba lagi otomatis (maks 3x, jeda 2 detik) sebelum\n// menyerah diam-diam, supaya tidak muncul sebagai error di log.\nmsg._retryCount = (msg._retryCount || 0) + 1;\nif (msg._retryCount > 3) {\n    node.warn(\"Web API tidak terjangkau setelah 3x percobaan (access-event): \" + (msg.error && msg.error.message));\n    return null;\n}\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1000,
        "y": 120,
        "wires": [
            [
                "access_httpRetryDelay"
            ]
        ]
    },
