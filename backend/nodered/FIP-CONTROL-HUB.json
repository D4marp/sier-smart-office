        "type": "function",
        "z": "fip_control_hub_tab",
        "name": "build_state_json_O2.02.10",
        "func": "// manual_override di UG65 (O2.02.1X-COLLECTOR.json) baca msg.payload.state\n// (dan msg.payload.source) setelah JSON parse, jadi bungkus dulu di sini.\nmsg.payload = JSON.stringify({ state: msg.payload, source: msg._source }) + \"\\n\";\nreturn msg;",
        "outputs": 1,
