    {
        "id": "hub_httpRetryFn",
        "type": "function",
        "z": "fip_control_hub_tab",
        "name": "retry_or_drop_hub",
        "func": "// Web API sesekali sempat tidak terjangkau sesaat. Coba lagi otomatis\n// (maks 3x, jeda 2 detik) sebelum menyerah diam-diam.\nmsg._retryCount = (msg._retryCount || 0) + 1;\nif (msg._retryCount > 3) {\n    node.warn(\"Web API tidak terjangkau setelah 3x percobaan (control-hub): \" + (msg.error && msg.error.message));\n    return null;\n}\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1000,
        "y": 480,
        "wires": [
            [
                "hub_httpRetryDelay"
            ]
        ]
    },
    {
        "id": "hub_httpRetryDelay",
        "type": "delay",
        "z": "fip_control_hub_tab",
        "name": "",
        "pauseType": "delay",
        "timeout": "2",
        "timeoutUnits": "seconds",
        "rate": "1",
        "nbRateUnits": "1",
        "rateUnits": "second",
        "randomFirst": "1",
        "randomLast": "5",
        "randomUnits": "seconds",
        "drop": false,
        "x": 1000,
        "y": 520,
        "wires": [
            [
                "hub_httpReq"
            ]
        ]
