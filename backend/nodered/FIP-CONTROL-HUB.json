    {
        "id": "hub_telemetryFn",
        "type": "function",
        "z": "fip_control_hub_tab",
        "name": "forward_telemetry_to_web",
        "func": "// UG65 tidak bisa HTTP -- kirim {method, url, payload} lewat TCP ke sini,\n// Mini PC yang benar-benar memanggil Web.\nvar p = msg.payload || {};\nif (!p.method || !p.url) {\n    node.warn(\"Payload telemetri tidak valid: \" + JSON.stringify(p));\n    return null;\n}\nmsg.method = p.method;\nmsg.url = p.url;\nmsg.payload = p.payload;\nmsg.headers = { \"content-type\": \"application/json\" };\nreturn msg;",
