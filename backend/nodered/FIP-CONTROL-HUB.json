    {
        "id": "hub_controlRouteFn",
        "type": "function",
        "z": "fip_control_hub_tab",
        "name": "route_control_by_classKey",
        "func": "// Terima {classKey, state, source} dari backend ATAU dari FIP-ACCESS-CONTROL\n// (tap RFID, source:\"door_access\"), validasi, siapkan msg.topic = classKey\n// supaya switch bisa memilih ruangan yang benar. \"source\" diteruskan apa\n// adanya ke UG65 -- manual_override di sana pakai ini untuk membedakan\n// jendela 25 menit (tap pintu) vs 30 menit (perintah Web/API).\nvar p = msg.payload || {};\nvar classKey = p.classKey;\nvar state = String(p.state || '').toLowerCase();\nvar source = p.source || 'web_api';\n\nif (!classKey || ![\"on\", \"off\"].includes(state)) {\n    node.warn(\"Payload kontrol tidak valid: \" + JSON.stringify(p));\n    return null;\n}\n\nmsg.topic = classKey;\nmsg.payload = state;\nmsg._source = source;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 120,
        "wires": [
            [
                "hub_controlSwitch"
            ]
        ]
    },
